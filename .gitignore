# venv
venv/
.venv/
__pycache__/
*.pyc

# raw & processed data stay out of git — cite sources in README instead,
# or use Git LFS if you specifically want them versioned
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# secrets / local config overrides
.env
config.local.yaml

# OS / editor
.DS_Store
.vscode/
*.swp

# notebooks checkpoints
.ipynb_checkpoints/

# streamlit
.streamlit/secrets.toml

# test cache
.pytest_cache/
.coverage
